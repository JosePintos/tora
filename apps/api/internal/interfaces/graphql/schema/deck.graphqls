type Deck {
    id: ID!
    ownerId: ID!
    name: String!
    createdAt: String!
    "The deck's cards, oldest first. Batched across decks by a DataLoader."
    cards: [Card!]!
}

input CreateDeckInput {
    name: String!
}

extend type Mutation {
    createDeck(input: CreateDeckInput!): Deck!
}

extend type Query {
    decks: [Deck!]!
}